{
  "name": "solid-tiny-router",
  "version": "0.2.5",
  "description": "Tiny router library for SolidJS",
  "keywords": [
    "router",
    "solid-js"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-tiny-router",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-tiny-router/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/solid-tiny-router.git",
    "directory": "packages/solid-tiny-router"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.jsx",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.jsx"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "solid-js": "^1.9.18",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "solid-js": "^1.2"
  },
  "engines": {
    "node": ">=10"
  }
}
